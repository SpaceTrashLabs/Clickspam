<Window x:Class="AutoClicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auto Clicker"
        Width="400"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        Icon="Assets/app.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <DockPanel>
        <!-- Title bar -->
        <Grid DockPanel.Dock="Top" Height="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Source="Assets/app-64.png" Width="18" Height="18" Margin="16,0,10,0"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Grid.Column="1" Text="Auto Clicker" FontSize="12" Foreground="{StaticResource Muted}"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <ToggleButton x:Name="PinButton" Style="{StaticResource ChromeButton}" Content="&#xE718;"
                              FontSize="12" ToolTip="Keep on top" WindowChrome.IsHitTestVisibleInChrome="True"
                              Click="PinButton_Click" />
                <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" ToolTip="Minimize"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="MinimizeButton_Click" />
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" ToolTip="Close"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseButton_Click" />
            </StackPanel>
        </Grid>

        <StackPanel Margin="16,4,16,6">

            <!-- Status + start/stop -->
            <Border Style="{StaticResource Card}" Padding="18,16,18,18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Muted}"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Text="Ready" Margin="8,0,0,0" FontSize="12"
                                   FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,14">
                        <TextBlock x:Name="CountText" Text="0" FontSize="40" FontWeight="SemiBold" />
                        <TextBlock Text="clicks" FontSize="14" Foreground="{StaticResource Muted}"
                                   VerticalAlignment="Bottom" Margin="8,0,0,10" />
                    </StackPanel>
                    <Button x:Name="RunButton" Style="{StaticResource PrimaryButton}"
                            Background="{StaticResource Accent}" Foreground="{StaticResource OnAccent}"
                            Click="RunButton_Click">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="RunGlyph" Text="&#xE768;" FontFamily="{StaticResource IconFont}"
                                           FontSize="14" VerticalAlignment="Center" />
                                <TextBlock x:Name="RunLabel" Text="Start clicking" Margin="10,0,0,0" FontSize="15"
                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#26000000"
                                    CornerRadius="6" Padding="8,3">
                                <TextBlock x:Name="RunKey" Text="F6" FontFamily="{StaticResource MonoFont}"
                                           FontSize="12" />
                            </Border>
                        </Grid>
                    </Button>
                    <TextBlock x:Name="HotkeyError" Style="{StaticResource Caption}" Foreground="{StaticResource Danger}"
                               Margin="0,10,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="SettingsPanel">

                <!-- Speed -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="SPEED" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="RateBox" Style="{StaticResource RateBox}" Text="10"
                                     TextChanged="RateBox_TextChanged" PreviewTextInput="RateBox_PreviewTextInput"
                                     PreviewMouseWheel="RateBox_PreviewMouseWheel" LostKeyboardFocus="RateBox_LostFocus" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,7,0">
                                <Button Style="{StaticResource StepButton}" Content="&#xE738;" ToolTip="Slower"
                                        Click="RateDown_Click" />
                                <Button Style="{StaticResource StepButton}" Content="&#xE710;" ToolTip="Faster"
                                        Margin="4,0,0,0" Click="RateUp_Click" />
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource SegmentTrack}" Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <UniformGrid Rows="1">
                                    <RadioButton x:Name="PerSecondRadio" Style="{StaticResource Segment}" GroupName="Unit"
                                                 Content="per sec" IsChecked="True" Checked="Unit_Checked" />
                                    <RadioButton x:Name="PerMinuteRadio" Style="{StaticResource Segment}" GroupName="Unit"
                                                 Content="per min" Checked="Unit_Checked" />
                                </UniformGrid>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="IntervalText" Style="{StaticResource Caption}" Margin="2,8,0,0"
                                   Text="One click every 100 ms" />
                    </StackPanel>
                </Border>

                <!-- Click -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="CLICK" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Button" />
                            <Border Grid.Column="1" Style="{StaticResource SegmentTrack}">
                                <UniformGrid Rows="1">
                                    <RadioButton x:Name="LeftRadio" Style="{StaticResource Segment}" GroupName="Button"
                                                 Content="Left" IsChecked="True" />
                                    <RadioButton x:Name="MiddleRadio" Style="{StaticResource Segment}" GroupName="Button"
                                                 Content="Middle" />
                                    <RadioButton x:Name="RightRadio" Style="{StaticResource Segment}" GroupName="Button"
                                                 Content="Right" />
                                </UniformGrid>
                            </Border>
                            <TextBlock Grid.Row="2" Style="{StaticResource RowLabel}" Text="Type" />
                            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource SegmentTrack}">
                                <UniformGrid Rows="1">
                                    <RadioButton x:Name="SingleRadio" Style="{StaticResource Segment}" GroupName="Type"
                                                 Content="Single" IsChecked="True" />
                                    <RadioButton x:Name="DoubleRadio" Style="{StaticResource Segment}" GroupName="Type"
                                                 Content="Double" />
                                </UniformGrid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Target -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="WHERE TO CLICK" />
                        <Border Style="{StaticResource SegmentTrack}">
                            <UniformGrid Rows="1">
                                <RadioButton x:Name="FollowRadio" Style="{StaticResource Segment}" GroupName="Target"
                                             Content="Follow the mouse" IsChecked="True" Checked="Target_Checked" />
                                <RadioButton x:Name="FixedRadio" Style="{StaticResource Segment}" GroupName="Target"
                                             Content="Fixed point" Checked="Target_Checked" />
                            </UniformGrid>
                        </Border>
                        <Grid Margin="2,10,0,0" MinHeight="32">
                            <TextBlock x:Name="TargetText" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                       Text="Clicks wherever your cursor is." />
                            <Button x:Name="PickButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                    Click="PickButton_Click" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE81D;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Pick on screen" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Hotkeys -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="HOTKEYS" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Start" Margin="0,0,10,0" />
                            <ToggleButton x:Name="StartKeyChip" Grid.Column="1" Style="{StaticResource KeyChip}"
                                          Content="F6" Checked="KeyChip_Checked" Unchecked="KeyChip_Unchecked" />
                            <TextBlock Grid.Column="3" Style="{StaticResource RowLabel}" Text="Stop" Margin="0,0,10,0" />
                            <ToggleButton x:Name="StopKeyChip" Grid.Column="4" Style="{StaticResource KeyChip}"
                                          Content="F7" Checked="KeyChip_Checked" Unchecked="KeyChip_Unchecked" />
                        </Grid>
                        <TextBlock x:Name="HotkeyHint" Style="{StaticResource Caption}" Margin="2,10,0,0"
                                   Text="Click a key to change it. Use the same key for both to toggle." />
                    </StackPanel>
                </Border>

            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
